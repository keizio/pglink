<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PGLink Admin CMS</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      body { font-family: 'Inter', sans-serif; }
      .hidden { display: none !important; }
      .dialog-backdrop {
        backdrop-filter: blur(4px);
        background-color: rgba(0, 0, 0, 0.5);
      }
      .dialog-enter { opacity: 0; transform: scale(0.95); }
      .dialog-enter-active { opacity: 1; transform: scale(1); transition: all 0.2s ease-out; }
      .dialog-exit { opacity: 1; transform: scale(1); }
      .dialog-exit-active { opacity: 0; transform: scale(0.95); transition: all 0.15s ease-in; }
      .fade-enter { opacity: 0; }
      .fade-enter-active { opacity: 1; transition: opacity 0.3s ease-out; }
      .fade-exit { opacity: 1; }
      .fade-exit-active { opacity: 0; transition: opacity 0.2s ease-in; }
      .slide-enter { opacity: 0; transform: translateY(-10px); }
      .slide-enter-active { opacity: 1; transform: translateY(0); transition: all 0.3s ease-out; }
    </style>
  </head>
  <body class="bg-slate-100 min-h-screen">
    {{> admin/login }}
    {{> admin/header }}
    {{> admin/dashboard }}
    {{> admin/applications }}
    {{> admin/payments }}
    {{> admin/subscriptions }}
    {{> admin/dialogs }}
    {{> admin/scripts }}
  </body>
</html>
