<!-- Dashboard Page Header -->
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8 page-header" data-page="dashboard">
  <div>
    <h2 class="text-2xl font-bold text-slate-800">Dashboard</h2>
    <p class="text-slate-500 mt-1">Overview of your payment system</p>
  </div>
</div>

<!-- Dashboard Content -->
<div id="content-dashboard" class="hidden">
  <!-- Summary Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <!-- Applications Card -->
    <div class="bg-white rounded-2xl shadow-lg border border-slate-200 p-6">
      <div class="flex items-center justify-between mb-4">
        <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
          </svg>
        </div>
        <span class="text-xs font-medium text-blue-600 bg-blue-50 px-2 py-1 rounded-full">Total</span>
      </div>
      <div class="text-3xl font-bold text-slate-800 mb-1" id="dash-total-apps">0</div>
      <div class="text-sm text-slate-500">Applications</div>
      <div class="mt-3 flex items-center gap-4 text-xs">
        <span class="text-green-600"><span id="dash-active-apps">0</span> active</span>
        <span class="text-slate-400"><span id="dash-inactive-apps">0</span> inactive</span>
      </div>
    </div>

    <!-- Payments Card -->
    <div class="bg-white rounded-2xl shadow-lg border border-slate-200 p-6">
      <div class="flex items-center justify-between mb-4">
        <div class="w-12 h-12 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-xl flex items-center justify-center">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <span class="text-xs font-medium text-emerald-600 bg-emerald-50 px-2 py-1 rounded-full">Payments</span>
      </div>
      <div class="text-3xl font-bold text-slate-800 mb-1" id="dash-total-payments">0</div>
      <div class="text-sm text-slate-500">Total Payments</div>
      <div class="mt-3 flex items-center gap-4 text-xs">
        <span class="text-green-600"><span id="dash-success-payments">0</span> success</span>
        <span class="text-red-500"><span id="dash-failed-payments">0</span> failed</span>
      </div>
    </div>

    <!-- Subscriptions Card -->
    <div class="bg-white rounded-2xl shadow-lg border border-slate-200 p-6">
      <div class="flex items-center justify-between mb-4">
        <div class="w-12 h-12 bg-gradient-to-br from-purple-500 to-purple-600 rounded-xl flex items-center justify-center">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
        </div>
        <span class="text-xs font-medium text-purple-600 bg-purple-50 px-2 py-1 rounded-full">Subscriptions</span>
      </div>
      <div class="text-3xl font-bold text-slate-800 mb-1" id="dash-total-subs">0</div>
      <div class="text-sm text-slate-500">Total Subscriptions</div>
      <div class="mt-3 flex items-center gap-4 text-xs">
        <span class="text-green-600"><span id="dash-active-subs">0</span> active</span>
        <span class="text-red-500"><span id="dash-cancelled-subs">0</span> cancelled</span>
      </div>
    </div>

    <!-- Volume Card -->
    <div class="bg-white rounded-2xl shadow-lg border border-slate-200 p-6">
      <div class="flex items-center justify-between mb-4">
        <div class="w-12 h-12 bg-gradient-to-br from-amber-500 to-orange-500 rounded-xl flex items-center justify-center">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
          </svg>
        </div>
        <span class="text-xs font-medium text-amber-600 bg-amber-50 px-2 py-1 rounded-full">Volume</span>
      </div>
      <div class="text-2xl font-bold text-slate-800 mb-1" id="dash-total-volume">Rp 0</div>
      <div class="text-sm text-slate-500">Total Volume</div>
      <div class="mt-3 flex items-center gap-4 text-xs">
        <span class="text-green-600"><span id="dash-success-rate">0</span>% success rate</span>
      </div>
    </div>
  </div>

  <!-- Charts Row -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    <!-- Payment Status Breakdown -->
    <div class="bg-white rounded-2xl shadow-lg border border-slate-200 p-6">
      <h3 class="text-lg font-semibold text-slate-800 mb-4">Payment Status</h3>
      <div class="grid grid-cols-2 gap-4">
        <div class="bg-yellow-50 rounded-xl p-4 text-center">
          <div class="text-2xl font-bold text-yellow-600" id="dash-pending-payments">0</div>
          <div class="text-sm text-yellow-700">Pending</div>
        </div>
        <div class="bg-green-50 rounded-xl p-4 text-center">
          <div class="text-2xl font-bold text-green-600" id="dash-payment-success">0</div>
          <div class="text-sm text-green-700">Success</div>
        </div>
        <div class="bg-red-50 rounded-xl p-4 text-center">
          <div class="text-2xl font-bold text-red-600" id="dash-payment-failed">0</div>
          <div class="text-sm text-red-700">Failed</div>
        </div>
        <div class="bg-slate-50 rounded-xl p-4 text-center">
          <div class="text-2xl font-bold text-slate-600" id="dash-payment-expired">0</div>
          <div class="text-sm text-slate-600">Expired</div>
        </div>
      </div>
    </div>

    <!-- Subscription Status Breakdown -->
    <div class="bg-white rounded-2xl shadow-lg border border-slate-200 p-6">
      <h3 class="text-lg font-semibold text-slate-800 mb-4">Subscription Status</h3>
      <div class="grid grid-cols-2 gap-4">
        <div class="bg-green-50 rounded-xl p-4 text-center">
          <div class="text-2xl font-bold text-green-600" id="dash-sub-active">0</div>
          <div class="text-sm text-green-700">Active</div>
        </div>
        <div class="bg-yellow-50 rounded-xl p-4 text-center">
          <div class="text-2xl font-bold text-yellow-600" id="dash-sub-paused">0</div>
          <div class="text-sm text-yellow-700">Paused</div>
        </div>
        <div class="bg-red-50 rounded-xl p-4 text-center">
          <div class="text-2xl font-bold text-red-600" id="dash-sub-cancelled">0</div>
          <div class="text-sm text-red-700">Cancelled</div>
        </div>
        <div class="bg-slate-50 rounded-xl p-4 text-center">
          <div class="text-2xl font-bold text-slate-600" id="dash-sub-expired">0</div>
          <div class="text-sm text-slate-600">Expired</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Daily Trend Chart -->
  <div class="bg-white rounded-2xl shadow-lg border border-slate-200 p-6 mb-8">
    <h3 class="text-lg font-semibold text-slate-800 mb-4">30-Day Transaction Trend</h3>
    <div class="h-64 flex items-end gap-1" id="trend-chart">
      <!-- Chart bars will be rendered here -->
    </div>
    <div class="flex justify-between mt-2 text-xs text-slate-500">
      <span>30 days ago</span>
      <span>Today</span>
    </div>
  </div>

  <!-- Recent Activity -->
  <div class="bg-white rounded-2xl shadow-lg border border-slate-200 overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-200">
      <h3 class="text-lg font-semibold text-slate-800">Recent Activity</h3>
    </div>
    <div class="divide-y divide-slate-200" id="recent-activity">
      <!-- Activity items will be rendered here -->
    </div>
  </div>
</div>
