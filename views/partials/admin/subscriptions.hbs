<!-- Subscriptions Page Header -->
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8 page-header" data-page="subscriptions">
  <div>
    <h2 class="text-2xl font-bold text-slate-800">Subscriptions</h2>
    <p class="text-slate-500 mt-1">View and manage all subscriptions</p>
  </div>
</div>

<!-- Subscriptions Content -->
<div id="content-subscriptions" class="hidden">
  <!-- Filters -->
  <div class="bg-white rounded-2xl shadow-lg border border-slate-200 p-6 mb-6">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div>
        <label class="block text-slate-700 text-sm font-medium mb-2">Application</label>
        <select id="subscription-app-filter" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-100 outline-none transition-all bg-white">
          <option value="">All Applications</option>
        </select>
      </div>
      <div>
        <label class="block text-slate-700 text-sm font-medium mb-2">Status</label>
        <select id="subscription-status-filter" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-100 outline-none transition-all bg-white">
          <option value="">All Status</option>
          <option value="ACTIVE">Active</option>
          <option value="PAUSED">Paused</option>
          <option value="CANCELLED">Cancelled</option>
          <option value="EXPIRED">Expired</option>
          <option value="FAILED">Failed</option>
        </select>
      </div>
      <div>
        <label class="block text-slate-700 text-sm font-medium mb-2">Start Date</label>
        <input id="subscription-start-date" type="date" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-100 outline-none transition-all" />
      </div>
      <div>
        <label class="block text-slate-700 text-sm font-medium mb-2">End Date</label>
        <input id="subscription-end-date" type="date" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-100 outline-none transition-all" />
      </div>
    </div>
    <div class="flex gap-3 mt-4">
      <button id="apply-subscription-filters" class="inline-flex items-center gap-2 bg-gradient-to-r from-blue-600 to-indigo-600 text-white px-5 py-2.5 rounded-xl font-medium hover:from-blue-700 hover:to-indigo-700 transition-all">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        Apply Filters
      </button>
      <button id="reset-subscription-filters" class="inline-flex items-center gap-2 bg-slate-100 text-slate-700 px-5 py-2.5 rounded-xl font-medium hover:bg-slate-200 transition-all">
        Reset
      </button>
    </div>
  </div>

  <!-- Subscriptions Table -->
  <div class="bg-white rounded-2xl shadow-lg border border-slate-200 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-200">
            <th class="px-4 py-4 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">Subscription ID</th>
            <th class="px-4 py-4 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">Amount</th>
            <th class="px-4 py-4 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">Billing Cycle</th>
            <th class="px-4 py-4 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">Provider</th>
            <th class="px-4 py-4 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">Status</th>
            <th class="px-4 py-4 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">Next Billing</th>
            <th class="px-4 py-4 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">Created</th>
          </tr>
        </thead>
        <tbody id="subscriptions-table-body" class="divide-y divide-slate-200"></tbody>
      </table>
    </div>
    <!-- Empty State -->
    <div id="subscriptions-empty-state" class="hidden p-12 text-center">
      <div class="w-16 h-16 bg-slate-100 rounded-full mx-auto mb-4 flex items-center justify-center">
        <svg class="w-8 h-8 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
      </div>
      <h3 class="text-lg font-medium text-slate-800 mb-1">No subscriptions found</h3>
      <p class="text-slate-500">Try adjusting your filters</p>
    </div>
    <!-- Pagination -->
    <div id="subscriptions-pagination" class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex items-center justify-between">
      <div class="text-sm text-slate-500">
        Showing <span id="subscriptions-from">0</span> to <span id="subscriptions-to">0</span> of <span id="subscriptions-total">0</span> results
      </div>
      <div class="flex items-center gap-2">
        <button id="subscriptions-prev" class="px-3 py-1.5 rounded-lg text-sm font-medium bg-white border border-slate-300 text-slate-600 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed">Previous</button>
        <button id="subscriptions-next" class="px-3 py-1.5 rounded-lg text-sm font-medium bg-white border border-slate-300 text-slate-600 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed">Next</button>
      </div>
    </div>
  </div>
</div>
