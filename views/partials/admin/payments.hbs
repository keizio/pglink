<!-- Payments Page Header -->
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8 page-header" data-page="payments">
  <div>
    <h2 class="text-2xl font-bold text-slate-800">Payments</h2>
    <p class="text-slate-500 mt-1">View and manage all payment transactions</p>
  </div>
</div>

<!-- Payments Content -->
<div id="content-payments" class="hidden">
  <!-- Filters -->
  <div class="bg-white rounded-2xl shadow-lg border border-slate-200 p-6 mb-6">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <div>
        <label class="block text-slate-700 text-sm font-medium mb-2">Application</label>
        <select id="payment-app-filter" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-100 outline-none transition-all bg-white">
          <option value="">All Applications</option>
        </select>
      </div>
      <div>
        <label class="block text-slate-700 text-sm font-medium mb-2">Status</label>
        <select id="payment-status-filter" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-100 outline-none transition-all bg-white">
          <option value="">All Status</option>
          <option value="PENDING">Pending</option>
          <option value="SUCCESS">Success</option>
          <option value="FAILED">Failed</option>
          <option value="EXPIRED">Expired</option>
        </select>
      </div>
      <div>
        <label class="block text-slate-700 text-sm font-medium mb-2">Start Date</label>
        <input id="payment-start-date" type="date" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-100 outline-none transition-all" />
      </div>
      <div>
        <label class="block text-slate-700 text-sm font-medium mb-2">End Date</label>
        <input id="payment-end-date" type="date" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-100 outline-none transition-all" />
      </div>
    </div>
    <div class="flex gap-3 mt-4">
      <button id="apply-payment-filters" class="inline-flex items-center gap-2 bg-gradient-to-r from-blue-600 to-indigo-600 text-white px-5 py-2.5 rounded-xl font-medium hover:from-blue-700 hover:to-indigo-700 transition-all">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        Apply Filters
      </button>
      <button id="reset-payment-filters" class="inline-flex items-center gap-2 bg-slate-100 text-slate-700 px-5 py-2.5 rounded-xl font-medium hover:bg-slate-200 transition-all">
        Reset
      </button>
    </div>
  </div>

  <!-- Payments Table -->
  <div class="bg-white rounded-2xl shadow-lg border border-slate-200 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full">
        <thead>
          <tr class="bg-slate-50 border-b border-slate-200">
            <th class="px-4 py-4 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">Order ID</th>
            <th class="px-4 py-4 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">Amount</th>
            <th class="px-4 py-4 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">Provider</th>
            <th class="px-4 py-4 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">Method</th>
            <th class="px-4 py-4 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">Status</th>
            <th class="px-4 py-4 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">Customer</th>
            <th class="px-4 py-4 text-left text-xs font-semibold text-slate-600 uppercase tracking-wider">Created</th>
          </tr>
        </thead>
        <tbody id="payments-table-body" class="divide-y divide-slate-200"></tbody>
      </table>
    </div>
    <!-- Empty State -->
    <div id="payments-empty-state" class="hidden p-12 text-center">
      <div class="w-16 h-16 bg-slate-100 rounded-full mx-auto mb-4 flex items-center justify-center">
        <svg class="w-8 h-8 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
      </div>
      <h3 class="text-lg font-medium text-slate-800 mb-1">No payments found</h3>
      <p class="text-slate-500">Try adjusting your filters</p>
    </div>
    <!-- Pagination -->
    <div id="payments-pagination" class="px-6 py-4 bg-slate-50 border-t border-slate-200 flex items-center justify-between">
      <div class="text-sm text-slate-500">
        Showing <span id="payments-from">0</span> to <span id="payments-to">0</span> of <span id="payments-total">0</span> results
      </div>
      <div class="flex items-center gap-2">
        <button id="payments-prev" class="px-3 py-1.5 rounded-lg text-sm font-medium bg-white border border-slate-300 text-slate-600 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed">Previous</button>
        <button id="payments-next" class="px-3 py-1.5 rounded-lg text-sm font-medium bg-white border border-slate-300 text-slate-600 hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed">Next</button>
      </div>
    </div>
  </div>
</div>
